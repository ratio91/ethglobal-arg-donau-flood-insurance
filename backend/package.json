{
  "name": "flood-insurance-backend",
  "version": "1.0.0",
  "description": "Backend service for managing flood insurance policies via MultiBaas",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "fdc:test": "tsx scripts/test-fdc-onchain.ts",
    "fdc:test:steps": "tsx scripts/test-fdc-onchain.ts --step-by-step",
    "contracts:list": "tsx scripts/list-contracts.ts"
  },
  "dependencies": {
    "@curvegrid/multibaas-sdk": "^1.1.0",
    "@flarenetwork/flare-periphery-contract-artifacts": "^0.1.38",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
