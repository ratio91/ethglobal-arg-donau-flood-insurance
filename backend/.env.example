# MultiBaaS Configuration
MULTIBAAS_URL=https://your-deployment.multibaas.com
MULTIBAAS_API_KEY=your-admin-api-key

# Contract Configuration
CONTRACT_LABEL=water-level-policy
CONTRACT_ADDRESS=0x9fd9f4DeD5691B67E55D35E7f1789c75e760249F
CHAIN_ID=114

# Flare FDC Configuration
FDC_VERIFIER_API_BASE=https://web2json-verifier-test.flare.rocks
FDC_API_KEY=  # Optional: API key for verifier service (if required)
FDC_SUBMITTER_WALLET=0xYourWalletAddress  # Optional: defaults to INSURER_WALLET_ADDRESS
USE_MOCK_FDC=false  # Set to true for testing without on-chain submission

# FdcHub Contract (for on-chain FDC submission)
FDCHUB_LABEL=fdchub11  # Optional: MultiBaas label for FdcHub contract (defaults to fdchub11)
FDCHUB_ADDRESS=0x52308001b46cB6b1d0E978A79e71D03996d891E6  # Optional: FdcHub address on Coston2

# Insurer Configuration
INSURER_WALLET_ADDRESS=0xYourInsurerWalletAddress
INSURER_WALLET_LABEL=ethglobal-buenos-1
AUTO_CLAIM_ENABLED=true

# Server Configuration
PORT=3000
MONITOR_INTERVAL_MS=120000
